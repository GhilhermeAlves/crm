# =============================================================================
# CRM SaaS Omnichannel — Variáveis de Ambiente (Produção)
# =============================================================================
# Copie este arquivo como .env e preencha os valores:
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL 17
# ---------------------------------------------------------------------------
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_64_CHARS_MIN
POSTGRES_DB=crm_main
POSTGRES_MEMORY_LIMIT=2G
POSTGRES_CPU_LIMIT=2.0

# Bancos separados (criados via script init, descomente conforme necessário)
# POSTGRES_AUTH_DB=auth_db
# POSTGRES_USER_DB=user_db
# POSTGRES_EMPLOYEE_DB=employee_db
# POSTGRES_STUDENT_DB=student_db
# POSTGRES_FINANCE_DB=finance_db
# POSTGRES_BILLING_DB=billing_db
# POSTGRES_ACADEMIC_DB=academic_db
# POSTGRES_ENROLLMENT_DB=enrollment_db
# POSTGRES_TENANT_DB=tenant_db

# ---------------------------------------------------------------------------
# Redis 7
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS_MIN
REDIS_MEMORY_LIMIT=512M
REDIS_CPU_LIMIT=1.0

# ---------------------------------------------------------------------------
# RabbitMQ 4
# ---------------------------------------------------------------------------
RABBITMQ_USER=crm_rabbitmq
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS_MIN
RABBITMQ_MEMORY_LIMIT=512M
RABBITMQ_CPU_LIMIT=1.0

# ---------------------------------------------------------------------------
# MinIO (S3-compatible)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=crm_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS_MIN
MINIO_DOMAIN=minio.local
MINIO_MEMORY_LIMIT=512M
MINIO_CPU_LIMIT=1.0

# ---------------------------------------------------------------------------
# Keycloak (IAM)
# ---------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS_MIN
KEYCLOAK_HOSTNAME=auth.crm.local
KEYCLOAK_HOSTNAME_PORT=443
KEYCLOAK_PATH=/auth
KEYCLOAK_MEMORY_LIMIT=1G
KEYCLOAK_CPU_LIMIT=1.0

# ---------------------------------------------------------------------------
# Rede
# ---------------------------------------------------------------------------
DOCKER_NETWORK_SUBNET=172.28.0.0/16
