# crm-auth-service — variáveis de ambiente
# ---------------------------------------------------------------
# Keycloak (JWKS sempre do Keycloak — o serviço não possui JWKS próprio)
AUTH_KEYCLOAK_ISSUER_URI=https://srv1348261.hstgr.cloud/realms/CRM
AUTH_KEYCLOAK_JWKS_URI=https://srv1348261.hstgr.cloud/realms/CRM/protocol/openid-connect/certs

# Banco CRM compartilhado (schema de propriedade do crm-backend)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/crm
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Access Gateway OIDC (Sprint 6.1) — o auth-service é o OAuth2 Client do Keycloak
# (client confidencial `crm-gateway`). redirect-uri FIXA (deve bater no Keycloak)
# e allowlist de redirect pós-login separada por vírgula.
AUTH_GATEWAY_CLIENT_ID=crm-gateway
AUTH_GATEWAY_CLIENT_SECRET=
AUTH_GATEWAY_REDIRECT_URI=http://localhost:8082/auth/callback
AUTH_GATEWAY_ALLOWED_REDIRECT_URIS=http://localhost:3000,https://srv1348261.hstgr.cloud

# Ciclo de vida da sessão (Sprint 6.2) — logout, refresh e CSRF cookie-to-header
AUTH_GATEWAY_SESSION_TTL=8h
AUTH_GATEWAY_SESSION_IDLE_TIMEOUT=30m
AUTH_GATEWAY_CSRF_COOKIE_NAME=XSRF-TOKEN
AUTH_GATEWAY_CSRF_HEADER_NAME=X-XSRF-TOKEN
AUTH_GATEWAY_APP_BASE_URL=http://localhost:3000

# BFF relay (Sprint 6.4) — base do crm-backend para repassar /api/** com o
# access token da sessão (o browser nunca detém o token).
AUTH_GATEWAY_API_BACKEND_URL=http://localhost:8081

# Rate limiting do Gateway (Sprint 6.6) — janela fixa distribuída em Redis.
# Chave por endpoint: authorize/callback por IP real; refresh/logout por sessão.
AUTH_GATEWAY_RATE_LIMIT_ENABLED=true
AUTH_GATEWAY_RATE_LIMIT_WINDOW=60s
AUTH_GATEWAY_RATE_LIMIT_AUTHORIZE=20
AUTH_GATEWAY_RATE_LIMIT_CALLBACK=20
AUTH_GATEWAY_RATE_LIMIT_REFRESH=30
AUTH_GATEWAY_RATE_LIMIT_LOGOUT=20
