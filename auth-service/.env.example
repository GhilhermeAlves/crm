# crm-auth-service — variáveis de ambiente
# ---------------------------------------------------------------
# Keycloak (JWKS sempre do Keycloak — o serviço não possui JWKS próprio)
AUTH_KEYCLOAK_ISSUER_URI=https://srv1348261.hstgr.cloud/realms/CRM
AUTH_KEYCLOAK_JWKS_URI=https://srv1348261.hstgr.cloud/realms/CRM/protocol/openid-connect/certs

# Banco CRM compartilhado (schema de propriedade do crm-backend)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/crm
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Access Gateway OIDC (Sprint 6.1) — o auth-service é o OAuth2 Client do Keycloak
# (client confidencial `crm-gateway`). redirect-uri FIXA (deve bater no Keycloak)
# e allowlist de redirect pós-login separada por vírgula.
AUTH_GATEWAY_CLIENT_ID=crm-gateway
AUTH_GATEWAY_CLIENT_SECRET=
AUTH_GATEWAY_REDIRECT_URI=http://localhost:8082/auth/callback
AUTH_GATEWAY_ALLOWED_REDIRECT_URIS=http://localhost:3000,https://srv1348261.hstgr.cloud
