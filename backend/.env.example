# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/crm
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Keycloak OAuth2 (autenticação via Keycloak)
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/CRM
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/CRM/protocol/openid-connect/certs

# Identity layer (crm-auth-service) — default: resolução local no backend
AUTH_IDENTITY_LAYER_ENABLED=false
AUTH_SERVICE_URL=http://localhost:8082

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Server
SERVER_PORT=8080

# Mail (provider real) — defina MAIL_PROVIDER=smtp e preencha SMTP_* para enviar
MAIL_PROVIDER=console
MAIL_FROM=
MAIL_FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
