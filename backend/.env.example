# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/crm
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Legacy JWT
JWT_SECRET=your-256-bit-secret-key-here
JWT_EXPIRATION=3600000

# Keycloak OAuth2 (opcional - para autenticação via Keycloak)
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/CRM
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/CRM/protocol/openid-connect/certs

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Server
SERVER_PORT=8080
