# ---------------------------------------------------------------------------
# WhatsApp (Omnichannel) — Evolution API v2 (self-hosted, /opt/evolution na VPS)
# Copie este arquivo para `.env` no ambiente e ajuste os valores reais.
# NUNCA commite os valores reais dos segredos.
# ---------------------------------------------------------------------------

# Provider do WhatsApp: evolution (Evolution API) ou fake (simulação, sem tráfego).
WHATSAPP_PROVIDER=evolution

# URL da Evolution API vista pelo backend (mesma rede Docker crm-network).
EVOLUTION_BASE_URL=http://evolution-api:8080

# AUTHENTICATION_API_KEY da Evolution (/opt/evolution/.env). Fallback global
# quando o canal não define `secrets_ref` (nome de outra variável com a chave).
EVOLUTION_API_KEY=

# Token do webhook. Configure na instância da Evolution a URL
#   http://backend:8080/api/v1/omnichannel/whatsapp/webhook?token=<valor>
# com os eventos MESSAGES_UPSERT e MESSAGES_UPDATE.
OMNICHANNEL_WHATSAPP_WEBHOOK_TOKEN=

# Quando false (padrão seguro), o webhook REJEITA requisições sem token válido.
# Apenas deixe true em desenvolvimento local.
WHATSAPP_WEBHOOK_ALLOW_UNSIGNED=false

# Sprint 6.10 (Task 1.8) — timeout de sessão ociosa do Access Gateway.
# Sessões permanecem ativas por 4h de inatividade (padrão 0s = sem expiração).
AUTH_GATEWAY_SESSION_IDLE_TIMEOUT=4h
