# ---------------------------------------------------------------------------
# WhatsApp (Omnichannel) — Fase A
# Copie este arquivo para `.env` no ambiente e ajuste os valores reais.
# NUNCA commite os valores reais dos segredos.
# ---------------------------------------------------------------------------

# Provider do WhatsApp: cloud-api (Meta/Cloud API) ou fake (simulação).
WHATSAPP_PROVIDER=cloud-api

# Token global de acesso (Bearer) para a WhatsApp Cloud API. Usado como
# fallback quando o canal não define um token por secrets_ref.
CRM_WHATSAPP_ACCESS_TOKEN=

# App Secret da WhatsApp Cloud API. Usado para validar a assinatura HMAC
# (X-Hub-Signature-256) dos webhooks recebidos do Meta.
CRM_WHATSAPP_APP_SECRET=

# Quando false (padrão seguro), o webhook REJEITA mensagens sem assinatura
# HMAC válida. Apenas deixe true em desenvolvimento local.
WHATSAPP_WEBHOOK_ALLOW_UNSIGNED=false

# Token de autenticação do webhook para providers que não usam HMAC do Meta
# (ex.: UAZAPI). A URL do webhook deve enviar `?token=<valor>` ou o header
# X-Uazapi-Token. Deixe vazio apenas se o provider usar o HMAC da Meta.
OMNICHANNEL_WHATSAPP_WEBHOOK_TOKEN=

# Token de verificação do handshake do webhook (hub.verify_token).
OMNICHANNEL_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Tokens por canal (opcional). Cada canal pode definir um `secrets_ref` cujo
# valor é o NOME de uma variável de ambiente com o token daquele canal; se
# ausente, cai para CRM_WHATSAPP_ACCESS_TOKEN. Exemplo:
# CRM_WHATSAPP_ACCOUNT_BANCOS_TOKEN=
